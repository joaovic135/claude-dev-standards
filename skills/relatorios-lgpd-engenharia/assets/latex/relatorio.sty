\newcommand{\FazerCapa}{%
  \begin{titlepage}
  \begin{tikzpicture}[remember picture,overlay]
    \fill[corprimaria] (current page.north west) rectangle ([xshift=2.35cm]current page.south west);
    \fill[corprimariaescura] ([xshift=2.35cm]current page.north west) rectangle ([xshift=2.5cm]current page.south west);
    \node[rotate=90,anchor=west,text=white,font=\sffamily\small] at ([xshift=1.28cm,yshift=2.6cm]current page.south west) {\textls[220]{\MakeUppercase{\rel@marca}}};
    \node[anchor=north west,text=corcinza,font=\sffamily\small,align=left] at ([xshift=4.0cm,yshift=-2.7cm]current page.north west) {\textls[160]{\MakeUppercase{\rel@marca}}\\[2pt]{\footnotesize\color{corsuave}\rel@empresa}};
    \node[anchor=north east,text=corprimaria,font=\sffamily\small\bfseries,align=right] at ([xshift=-2.6cm,yshift=-2.7cm]current page.north east) {\textls[160]{\MakeUppercase{\rel@volume}}};
    \node[anchor=west,text width=13.6cm,align=left] at ([xshift=4.0cm,yshift=3.0cm]current page.west) {%
      {\color{corprimaria}\rule{2.4cm}{2.2pt}}\par\vspace{16pt}
      {\fontsize{28}{34}\selectfont\bfseries\color{cortinta}\RaggedRight\hyphenpenalty=10000\exhyphenpenalty=10000 \rel@titulo\par}
      \vspace{14pt}
      {\fontsize{14}{19.5}\selectfont\itshape\color{corcinza}\RaggedRight\hyphenpenalty=10000 \rel@subtitulo\par}};
    \node[anchor=south west,text width=13.6cm,align=left] at ([xshift=4.0cm,yshift=3.1cm]current page.south west) {%
      \renewcommand{\arraystretch}{1.35}%
      \begin{tabular}{@{}>{\sffamily\scriptsize\color{corcinza}}p{3.1cm}@{\hspace{0.4cm}}>{\small\color{cortinta}\RaggedRight\hyphenpenalty=10000\arraybackslash}p{9.6cm}@{}}
        \textls[110]{DESTINATÁRIO} & \rel@destinatario\\
        \textls[110]{ELABORAÇÃO} & \rel@autor\ifx\rel@cargo\@empty\else, \rel@cargo\fi\\
        \textls[110]{VERSÃO E DATA} & \rel@versao\ \textperiodcentered\ \rel@data\\
        \textls[110]{CLASSIFICAÇÃO} & \rel@classificacao\\
      \end{tabular}};
    \draw[corsuave,line width=0.4pt] ([xshift=4.0cm,yshift=2.75cm]current page.south west) -- ([xshift=-2.6cm,yshift=2.75cm]current page.south east);
    \node[anchor=north west,text=corsuave,font=\sffamily\scriptsize] at ([xshift=4.0cm,yshift=2.55cm]current page.south west) {\rel@empresa\ifx\rel@identificacao\@empty\else\ \textperiodcentered\ \rel@identificacao\fi};
  \end{tikzpicture}
  \end{titlepage}
  \setcounter{page}{2}%
}

